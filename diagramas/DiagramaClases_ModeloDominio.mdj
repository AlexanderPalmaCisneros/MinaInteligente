								},
								{
									"_type": "UMLAttribute",
									"_id": "a3acd79d83444832918b94bc405c0017",
									"_parent": {
										"$ref": "508112b5c04244ca95455edc9a825b57"
									},
									"name": "ultimaActualizacion",
									"documentation": "Marca de tiempo de la ultima llamada a ObtenerLectura(); permite calcular deltaTiempo internamente sin alterar la firma de FuenteDatos.ObtenerLectura() (se mantiene el patron Strategy).",
									"visibility": "private",
									"type": "DateTime"
								}
							],
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "065aa0a93b344a20b535cfb755b17bc5",
									"_parent": {
										"$ref": "508112b5c04244ca95455edc9a825b57"
									},
									"name": "ObtenerLectura",
									"documentation": "Implementa ambas ramas de la formula 4.1 usando zonaSimulada.ObtenerVentilador() y zonaSimulada.GetVolumen(). deltaTiempo se calcula internamente (ahora - ultimaActualizacion), sin agregar parametros a la firma heredada de FuenteDatos: si Ventilador.EstaEncendido(): valorSimulado *= e^(-(caudal/volumen) x deltaTiempo); si no: valorSimulado += generacionGas x deltaTiempo. Actualiza ultimaActualizacion y retorna valorSimulado.",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "2dc6fa746a4d4056ad0c78962369fc1e",
											"_parent": {
