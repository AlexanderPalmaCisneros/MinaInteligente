									},
									"name": "concentracionActual",
									"documentation": "Valor autoritativo del entorno de la zona. Ya no se calcula con formula propia: ActualizarConcentracion() lo sincroniza directamente desde el SensorGas de la zona.",
									"visibility": "private",
									"type": "double"
								},
								{
									"_type": "UMLAttribute",
									"_id": "2322969ae7fb4309b107e0dbd1e28cd5",
									"_parent": {
										"$ref": "f10b81d4a63c41edb5881100867dc714"
									},
